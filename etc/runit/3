#!/bin/sh
# runit stage 3 - shutdown.
# License: MIT
#
# runit has already terminated stage 2 by the time this runs, so runsvdir
# is gone and its runsv children have been reparented to runit itself. They
# are still supervising, so they are stopped here, in two steps:
#
#   1. force-stop   each service goes down, and is killed if it will not
#   2. shutdown     each runsv exits, which closes its log service's stdin
#                   and waits for the log service to drain and terminate
#
# Both steps are bounded by SV_STOP_TIMEOUT seconds (default 25), chosen to
# finish inside a container runtime's usual 30 second stop timeout so the
# container exits on its own rather than being killed.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

timeout=${SV_STOP_TIMEOUT:-25}
record=${SV_SVDIR_RECORD:-/run/runit/svdir}

msg() {
	echo "stage 3: $*"
}

# The tree stage 2 supervised, which this never works out for itself: a
# second copy of that decision is a copy that can disagree, and stopping
# the wrong tree looks exactly like stopping the right one until the
# runtime kills the container. runsvdir.sh records the tree as stage 2
# starts it. Without a record - stage 2 never got that far, or
# /etc/runit/2 is not runsvdir.sh - runsvdir.sh is asked which tree it
# would choose, which is still the one piece of code that decides.
find_svdir() {
	if [ -r "$record" ] && IFS= read -r svdir <"$record" && [ -d "$svdir" ]
	then
		svdir_from="recorded by stage 2"
		return 0
	fi
	for candidate in runsvdir.sh /usr/local/bin/runsvdir.sh /usr/bin/runsvdir.sh
	do
		command -v "$candidate" >/dev/null 2>&1 || continue
		svdir=$("$candidate" --print-svdir) || return 1
		[ -d "$svdir" ] || return 1
		svdir_from="no record, so as runsvdir.sh resolves it"
		return 0
	done
	return 1
}

if ! find_svdir
then
	msg "no service directory found; nothing to stop"
	exit 0
fi

services=""
for service in "$svdir"/*
do
	[ -d "$service" ] || continue
	services="$services $service"
done

if [ -z "$services" ]
then
	msg "no services in $svdir ($svdir_from)"
else
	msg "stopping services in $svdir ($svdir_from, timeout ${timeout}s)"
	# shellcheck disable=SC2086  # each service is a separate argument
	sv -w "$timeout" force-stop $services || msg "some services did not stop cleanly"

	msg "letting log services finish"
	# shellcheck disable=SC2086
	sv -w "$timeout" shutdown $services || msg "some log services did not finish in time"
fi

for hook in /etc/runit/stage3.d/*.sh
do
	if [ -r "$hook" ]
	then
		msg "running hook $hook"
		# shellcheck disable=SC1090  # supplied by the image, not by us
		. "$hook"
	fi
done

sync
msg "done"
